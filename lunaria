// 3. RPG RIVAL SPRITE (Dark Champion: Mantle, Obsidian Pauldrons, Horned Helm)
void drawRival(HDC hdc, int cx, int cy, bool hurt) {
    int dir = enemy.facing;
    int bob = (int)(std::sin(enemy.walkCycle) * 2.0f);
    int legOffset = (int)(std::cos(enemy.walkCycle) * 3.0f);

    // 1. Dark Shadow Mist
    HBRUSH mistB = CreateSolidBrush(hurt ? RGB(255, 80, 80) : RGB(50, 20, 40));
    SelectObject(hdc, mistB);
    SelectObject(hdc, GetStockObject(NULL_PEN));
    Ellipse(hdc, cx - 22, cy - 22, cx + 22, cy + 22);
    DeleteObject(mistB);

    // 2. Bloodsilk Mantle (Flowing Cape)
    HBRUSH capeB = CreateSolidBrush(COLOR_RIVAL_CAPE);
    SelectObject(hdc, capeB);
    POINT capePts[4] = {
        { cx - 11, cy - 6 + bob },
        { cx + 11, cy - 6 + bob },
        { cx + (12 * dir), cy + 20 },
        { cx - (8 * dir), cy + 20 }
    };
    Polygon(hdc, capePts, 4);
    DeleteObject(capeB);

    // 3. Obsidian Sabatons (Boots)
    HBRUSH bootB = CreateSolidBrush(RGB(30, 20, 35));
    SelectObject(hdc, bootB);
    Ellipse(hdc, cx - 8 + legOffset, cy + 14, cx - 1 + legOffset, cy + 22);
    Ellipse(hdc, cx + 1 - legOffset, cy + 14, cx + 8 - legOffset, cy + 22);
    DeleteObject(bootB);

    // 4. Obsidian Plate Armor & Spiked Pauldrons (Shoulders)
    HBRUSH armorB = CreateSolidBrush(COLOR_RIVAL_ARMOR);
    SelectObject(hdc, armorB);
    HPEN armorP = CreatePen(PS_SOLID, 1, RGB(160, 60, 95));
    SelectObject(hdc, armorP);
    Ellipse(hdc, cx - 9, cy - 6 + bob, cx + 9, cy + 14 + bob);

    // Spiked Pauldrons
    Ellipse(hdc, cx - 14, cy - 8 + bob, cx - 6, cy + 2 + bob);
    Ellipse(hdc, cx + 6, cy - 8 + bob, cx + 14, cy + 2 + bob);
    DeleteObject(armorB);
    DeleteObject(armorP);

    // 5. Pale Head & Shadow Hair
    HBRUSH skinB = CreateSolidBrush(COLOR_RIVAL_SKIN);
    SelectObject(hdc, skinB);
    Ellipse(hdc, cx - 7, cy - 16 + bob, cx + 7, cy - 2 + bob);
    DeleteObject(skinB);

    HBRUSH hairB = CreateSolidBrush(COLOR_RIVAL_HAIR);
    SelectObject(hdc, hairB);
    Ellipse(hdc, cx - 8, cy - 18 + bob, cx + 8, cy - 7 + bob);
    DeleteObject(hairB);

    // 6. Jagged Horns / Crown
    HPEN hornP = CreatePen(PS_SOLID, 2, RGB(220, 60, 100));
    SelectObject(hdc, hornP);
    MoveToEx(hdc, cx - 6, cy - 15 + bob, NULL);
    LineTo(hdc, cx - 12, cy - 26 + bob);
    MoveToEx(hdc, cx + 6, cy - 15 + bob, NULL);
    LineTo(hdc, cx + 12, cy - 26 + bob);
    DeleteObject(hornP);

    // 7. Glowing Ruby Eyes
    HBRUSH eyeB = CreateSolidBrush(COLOR_RIVAL_EYES);
    SelectObject(hdc, eyeB);
    int eyeDir = (dir == 1) ? 1 : -3;
    Ellipse(hdc, cx + eyeDir - 3, cy - 10 + bob, cx + eyeDir - 1, cy - 7 + bob);
    Ellipse(hdc, cx + eyeDir + 1, cy - 10 + bob, cx + eyeDir + 3, cy - 7 + bob);
    DeleteObject(eyeB);

    // 8. Equiped Rival Weapon in Hand
    int wepX = cx + (12 * dir);
    int wepY = cy + 4 + bob;

    if (enemy.weaponType == WEAPON_SCYTHE) {
        HPEN scytheP = CreatePen(PS_SOLID, 2, RGB(180, 170, 210));
        SelectObject(hdc, scytheP);
        MoveToEx(hdc, wepX, wepY + 14, NULL);
        LineTo(hdc, wepX, wepY - 22);
        Arc(hdc, wepX - 16, wepY - 30, wepX + 16, wepY - 10, wepX, wepY - 30, wepX + (14 * dir), wepY - 14);
        DeleteObject(scytheP);
    } else if (enemy.weaponType == WEAPON_CLEAVER) {
        HPEN cleaverP = CreatePen(PS_SOLID, 3, RGB(240, 70, 95));
        SelectObject(hdc, cleaverP);
        MoveToEx(hdc, wepX - 2, wepY + 8, NULL);
        LineTo(hdc, wepX + (6 * dir), wepY - 18);
        MoveToEx(hdc, wepX + (6 * dir), wepY - 18, NULL);
        LineTo(hdc, wepX + (14 * dir), wepY - 10);
        DeleteObject(cleaverP);
    } else { // SPEAR
        HPEN spearP = CreatePen(PS_SOLID, 2, RGB(230, 235, 250));
        SelectObject(hdc, spearP);
        MoveToEx(hdc, wepX - (4 * dir), wepY + 16, NULL);
        LineTo(hdc, wepX + (10 * dir), wepY - 26);
        // Spearhead red tassel
        HPEN tasselP = CreatePen(PS_SOLID, 2, RGB(255, 60, 60));
        SelectObject(hdc, tasselP);
        MoveToEx(hdc, wepX + (6 * dir), wepY - 18, NULL);
        LineTo(hdc, wepX + (4 * dir), wepY - 12);
        DeleteObject(tasselP);
        DeleteObject(spearP);
    }

    // Overhead Tag Info
    int tagX = cx - 45;
    int tagY = cy - 44;

    RECT tagBgRc = { tagX - 4, tagY - 2, tagX + 94, tagY + 24 };
    HBRUSH tagBgB = CreateSolidBrush(RGB(24, 14, 38));
    FillRect(hdc, &tagBgRc, tagBgB);
    DeleteObject(tagBgB);

    HPEN tagBorderP = CreatePen(PS_SOLID, 1, RGB(180, 50, 90));
    HPEN oldTagP = (HPEN)SelectObject(hdc, tagBorderP);
    SelectObject(hdc, GetStockObject(NULL_BRUSH));
    Rectangle(hdc, tagBgRc.left, tagBgRc.top, tagBgRc.right, tagBgRc.bottom);
    SelectObject(hdc, oldTagP);
    DeleteObject(tagBorderP);

    SelectObject(hdc, hEnemyTagFont);
    SetTextColor(hdc, RGB(255, 140, 180));
    std::wstring tagText = L"[Lv." + std::to_wstring(enemy.level) + L"] " + enemy.name.substr(0, 10);
    TextOutW(hdc, tagX, tagY, tagText.c_str(), tagText.length());

    int barW = 86;
    int barH = 5;
    int barX = tagX;
    int barY = tagY + 14;

    HBRUSH barBgB = CreateSolidBrush(RGB(40, 20, 35));
    RECT barBgRc = { barX, barY, barX + barW, barY + barH };
    FillRect(hdc, &barBgRc, barBgB);
    DeleteObject(barBgB);

    float hpPct = std::max(0.0f, std::min(1.0f, (float)enemy.hp / (float)enemy.maxHp));
    int fillW = (int)(barW * hpPct);
    if (fillW > 0) {
        HBRUSH fillB = CreateSolidBrush(RGB(255, 60, 90));
        RECT fillRc = { barX, barY, barX + fillW, barY + barH };
        FillRect(hdc, &fillRc, fillB);
        DeleteObject(fillB);
    }
}

