void appendLog(const std::wstring& text) {
    std::wstringstream ss(text);
    std::wstring line;
    while (std::getline(ss, line)) {
        if (!line.empty()) {
            logLines.push_back(line);
            if (logLines.size() > 7) {
                logLines.erase(logLines.begin());
            }
        }
    }
}

void spawnParticles(float x, float y, int count, COLORREF color, float maxSpeed, int lifeSpan, int size = 3) {
    for (int i = 0; i < count; ++i) {
        Particle p;
        p.x = x;
        p.y = y;
        float angle = ((float)std::rand() / RAND_MAX) * 6.283185f;
        float speed = (((float)std::rand() / RAND_MAX) * maxSpeed) + 0.5f;
        p.vx = std::cos(angle) * speed;
        p.vy = std::sin(angle) * speed;
        p.life = lifeSpan + (std::rand() % 6);
        p.color = color;
        p.size = size;
        particles.push_back(p);
    }
}

std::wstring generateUniqueMonsterName() {
    static const std::vector<std::wstring> prefixes = {
        L"Lilith", L"Morrigan", L"Morgana", L"Selene", L"Nyx", 
        L"Astrid", L"Isolde", L"Vespera", L"Ravena", L"Freya"
    };
    static const std::vector<std::wstring> titles = {
        L"the Moonlit Siren", L"the Shadow Witch", L"the Blood Empress",
        L"the Frost Valkyrie", L"the Twilight Stalker", L"the Void Weaver"
    };
    return prefixes[std::rand() % prefixes.size()] + L" " + titles[std::rand() % titles.size()];
}

void spawnEnemy() {
    enemy.name = generateUniqueMonsterName();
    enemy.level = 1 + (player.wins / 2);
    enemy.maxHp = 45 + (enemy.level * 25);
    enemy.hp = enemy.maxHp;
    enemy.facing = -1;
    enemy.walkCycle = 0.0f;
    
    int wChoice = std::rand() % 3;
    if (wChoice == 0) {
        enemy.weaponType = WEAPON_SCYTHE;
        enemy.weaponName = L"Void Scythe";
        enemy.attackReach = 54.0f;
        enemy.attack = 8 + (enemy.level * 3);
    } else if (wChoice == 1) {
        enemy.weaponType = WEAPON_CLEAVER;
        enemy.weaponName = L"Blood Cleaver";
        enemy.attackReach = 44.0f;
        enemy.attack = 12 + (enemy.level * 4);
    } else {
        enemy.weaponType = WEAPON_SPEAR;
        enemy.weaponName = L"Obsidian Spear";
        enemy.attackReach = 62.0f;
        enemy.attack = 7 + (enemy.level * 3);
    }

    enemy.x = ARENA_X + ARENA_W - 75.0f;
    enemy.y = PLAY_TOP + 80.0f;
    enemy.vx = 0.0f;
    enemy.vy = 0.0f;
    enemy.hurtFlash = 0;

    minions.clear();
    int minionCount = (enemy.level > 1) ? (std::min)(3, enemy.level - 1) : 0;
    for (int i = 0; i < minionCount; ++i) {
        Minion m;
        m.x = enemy.x + (std::rand() % 30 - 15);
        m.y = enemy.y + (i * 40.0f - (minionCount * 18.0f));
        m.maxHp = 18 + (enemy.level * 8);
        m.hp = m.maxHp;
        m.attack = 4 + (enemy.level * 2);
        m.active = true;
        minions.push_back(m);
    }

    appendLog(L"✦ [Lv." + std::to_wstring(enemy.level) + L"] " + enemy.name + L" enters with " + enemy.weaponName + L"!");
    if (minionCount > 0) {
        appendLog(L" [!] Accompanied by " + std::to_wstring(minionCount) + L" Shadow Thrall minions!");
    }
}

void triggerLevelUp() {
    player.level++;
    player.maxHp += 25;
    player.hp = player.maxHp;
    player.attack += 5;
    player.expNeeded = static_cast<int>(player.expNeeded * 1.6);
    isLevelUpPaused = true;

    spawnParticles(player.x, player.y, 45, COLOR_STAR_GOLD, 4.5f, 25, 4);

    appendLog(L"★ LEVEL UP! Reached Level " + std::to_wstring(player.level) + L"! ★");
    appendLog(L"> Sanctuary open! Press [1-4] to upgrade, [ENTER] to resume.");
}

void restartGame() {
    player.level = 1;
    player.exp = 0;
    player.expNeeded = 40;
    player.maxHp = 100;
    player.hp = player.maxHp;
    player.attack = 24;
    player.weaponTier = 1;
    player.armorTier = 1;
    player.potions = 3;
    player.gold = 40;
    player.wins = 0;
    player.x = ARENA_X + 80.0f;
    player.y = PLAY_TOP + 80.0f;
    player.facing = 1;
    player.walkCycle = 0.0f;
    player.isMoving = false;
    player.attackCooldown = 0;
    player.novaCooldown = 0;
    player.rayCooldown = 0;
    companion.active = false;
    companion.tier = 0;
    companion.wingTimer = 0.0f;
    minions.clear();
    projectiles.clear();
    particles.clear();
    logLines.clear();
    eclipseRay.active = false;
    gameOver = false;
    isLevelUpPaused = false;
    
    appendLog(L"✧ ARENA OF THE STAR MAIDEN ✧");
    appendLog(L"Controls: [W,A,S,D] Move | [SPACE] Slash | [Q] Nova | [R] Ray | [E] Elixir");
    spawnEnemy();
}

void startGame() {
    if (gameStarted) return;
    gameStarted = true;
    restartGame();
}

void onEnemyDefeated() {
    enemy.hp = 0;
    player.wins++;
    int bounty = 25 + (std::rand() % 15);
    int expGained = 25 + (enemy.level * 15);
    player.gold += bounty;
    player.exp += expGained;

    spawnParticles(enemy.x, enemy.y, 40, RGB(255, 90, 160), 3.5f, 24, 4);
    appendLog(L"[VICTORY] Rival defeated! +" + std::to_wstring(bounty) + L"g | +" + std::to_wstring(expGained) + L" EXP");

    if (player.exp >= player.expNeeded) {
        player.exp -= player.expNeeded;
        triggerLevelUp();
    } else {
        spawnEnemy();
    }
}

void updateGamePhysics() {
    if (!gameStarted || gameOver || isLevelUpPaused) return;

    const float SPEED = 3.8f;
    player.vx = 0.0f;
    player.vy = 0.0f;

    if (keys['W'] || keys[VK_UP])    player.vy -= SPEED;
    if (keys['S'] || keys[VK_DOWN])  player.vy += SPEED;
    if (keys['A'] || keys[VK_LEFT])  { player.vx -= SPEED; player.facing = -1; }
    if (keys['D'] || keys[VK_RIGHT]) { player.vx += SPEED; player.facing =  1; }

    player.isMoving = (player.vx != 0.0f || player.vy != 0.0f);
    if (player.isMoving) player.walkCycle += 0.25f;
    else player.walkCycle = 0.0f;

    player.x += player.vx;
    player.y += player.vy;

    player.x = (std::max)(static_cast<float>(ARENA_X + player.radius + 6), (std::min)(static_cast<float>(ARENA_X + ARENA_W - player.radius - 6), player.x));
    player.y = (std::max)(static_cast<float>(PLAY_TOP + player.radius + 6), (std::min)(static_cast<float>(ARENA_Y + ARENA_H - player.radius - 6), player.y));

    // Fairy Companion Movement & Animated Flutter
    if (companion.active) {
        companion.wingTimer += 0.35f;
        float cdx = (player.x - 28.0f * player.facing) - companion.x;
        float cdy = (player.y - 20.0f) - companion.y;
        companion.x += cdx * 0.08f;
        companion.y += cdy * 0.08f;

        companion.attackTimer++;
        if (companion.attackTimer >= 45) {
            companion.attackTimer = 0;
            float tx = enemy.x;
            float ty = enemy.y;
            if (!minions.empty() && minions[0].active) {
                tx = minions[0].x;
                ty = minions[0].y;
            }
            float tdx = tx - companion.x;
            float tdy = ty - companion.y;
            float tdist = std::sqrt(tdx * tdx + tdy * tdy);
            if (tdist > 0.0f) {
                Projectile pr;
                pr.x = companion.x;
                pr.y = companion.y;
                pr.vx = (tdx / tdist) * 6.5f;
                pr.vy = (tdy / tdist) * 6.5f;
                pr.damage = 10 + (companion.tier * 6);
                projectiles.push_back(pr);
            }
        }
    }

    // Rival AI Movement & Facing
    float dx = player.x - enemy.x;
    float dy = player.y - enemy.y;
    float dist = std::sqrt(dx * dx + dy * dy);

    enemy.facing = (dx >= 0) ? 1 : -1;
    if (dist > 38.0f) {
        float espeed = 1.6f + (enemy.level * 0.15f);
        enemy.x += (dx / dist) * espeed;
        enemy.y += (dy / dist) * espeed;
        enemy.walkCycle += 0.2f;
    }

    enemy.x = (std::max)(static_cast<float>(ARENA_X + enemy.radius + 6), (std::min)(static_cast<float>(ARENA_X + ARENA_W - enemy.radius - 6), enemy.x));
    enemy.y = (std::max)(static_cast<float>(PLAY_TOP + enemy.radius + 6), (std::min)(static_cast<float>(ARENA_Y + ARENA_H - enemy.radius - 6), enemy.y));

    for (auto& m : minions) {
        if (!m.active) continue;
        float mdx = player.x - m.x;
        float mdy = player.y - m.y;
        float mdist = std::sqrt(mdx * mdx + mdy * mdy);
        if (mdist > 20.0f) {
            m.x += (mdx / mdist) * 2.2f;
            m.y += (mdy / mdist) * 2.2f;
        }

        if (m.attackCooldown > 0) m.attackCooldown--;
        if (m.hurtFlash > 0) m.hurtFlash--;

        if (mdist < 24.0f && m.attackCooldown == 0) {
            player.hp -= m.attack;
            player.hurtFlash = 6;
            m.attackCooldown = 50;
            spawnParticles(player.x, player.y, 8, RGB(255, 60, 60), 2.0f, 10, 2);
            if (player.hp <= 0) {
                player.hp = 0;
                gameOver = true;
                appendLog(L"[DEFEAT] Slain by minions! Press [ENTER] to restart.");
            }
        }
    }

    for (size_t i = 0; i < projectiles.size(); ) {
        projectiles[i].x += projectiles[i].vx;
        projectiles[i].y += projectiles[i].vy;
        projectiles[i].life--;

        bool hit = false;
        float pdx = enemy.x - projectiles[i].x;
        float pdy = enemy.y - projectiles[i].y;
        if (std::sqrt(pdx * pdx + pdy * pdy) < enemy.radius + 6.0f) {
            enemy.hp -= projectiles[i].damage;
            enemy.hurtFlash = 8;
            spawnParticles(enemy.x, enemy.y, 10, COLOR_FAIRY_GLOW, 2.5f, 10, 3);
            hit = true;
            if (enemy.hp <= 0) onEnemyDefeated();
        }

        if (!hit) {
            for (auto& m : minions) {
                if (!m.active) continue;
                float mdx = m.x - projectiles[i].x;
                float mdy = m.y - projectiles[i].y;
                if (std::sqrt(mdx * mdx + mdy * mdy) < m.radius + 6.0f) {
                    m.hp -= projectiles[i].damage;
                    m.hurtFlash = 8;
                    hit = true;
                    if (m.hp <= 0) {
                        m.active = false;
                        player.gold += 8;
                        player.exp += 10;
                    }
                    break;
                }
            }
        }

        if (hit || projectiles[i].life <= 0) {
            projectiles.erase(projectiles.begin() + i);
        } else {
            i++;
        }
    }

    if (enemy.attackCooldown > 0) enemy.attackCooldown--;
    if (player.attackCooldown > 0) player.attackCooldown--;
    if (player.novaCooldown > 0) player.novaCooldown--;
    if (player.rayCooldown > 0) player.rayCooldown--;
    if (player.hurtFlash > 0) player.hurtFlash--;
    if (enemy.hurtFlash > 0) enemy.hurtFlash--;

    for (size_t i = 0; i < particles.size(); ) {
        particles[i].x += particles[i].vx;
        particles[i].y += particles[i].vy;
        particles[i].life--;
        if (particles[i].life <= 0) particles.erase(particles.begin() + i);
        else i++;
    }

    if (eclipseRay.active) {
        eclipseRay.timer--;
        if (eclipseRay.timer <= 0) eclipseRay.active = false;
    }

    if (dist <= enemy.attackReach && enemy.attackCooldown == 0) {
        int dmg = enemy.attack + (std::rand() % 5);
        player.hp -= dmg;
        player.hurtFlash = 8;
        enemy.attackCooldown = 45;

        spawnParticles(player.x, player.y, 16, RGB(255, 60, 90), 2.8f, 15, 3);
        appendLog(L"[!] " + enemy.name + L" struck with " + enemy.weaponName + L" for " + std::to_wstring(dmg) + L" dmg!");

        if (player.hp <= 0) {
            player.hp = 0;
            gameOver = true;
            appendLog(L"[DEFEAT] Fallen in battle! Press [ENTER] to restart.");
        }
    }
}

void playerAttack() {
    if (gameOver || !gameStarted || isLevelUpPaused || player.attackCooldown > 0) return;

    player.attackCooldown = 18;
    spawnParticles(player.x + (player.facing * 16.0f), player.y, 10, COLOR_TEXT_HEADER, 2.5f, 10, 3);

    float dx = enemy.x - player.x;
    float dy = enemy.y - player.y;
    if (std::sqrt(dx * dx + dy * dy) < 68.0f) {
        int dmg = player.attack + (std::rand() % 8);
        enemy.hp -= dmg;
        enemy.hurtFlash = 8;
        spawnParticles(enemy.x, enemy.y, 18, COLOR_STAR_GOLD, 3.2f, 14, 4);
        appendLog(L"> Astral Blade hit " + enemy.name + L" for " + std::to_wstring(dmg) + L" dmg!");
        if (enemy.hp <= 0) onEnemyDefeated();
    }

    for (auto& m : minions) {
        if (!m.active) continue;
        float mdx = m.x - player.x;
        float mdy = m.y - player.y;
        if (std::sqrt(mdx * mdx + mdy * mdy) < 64.0f) {
            int dmg = player.attack + (std::rand() % 6);
            m.hp -= dmg;
            m.hurtFlash = 8;
            if (m.hp <= 0) {
                m.active = false;
                player.gold += 8;
                player.exp += 10;
            }
        }
    }
}

void playerCastNova() {
    if (gameOver || !gameStarted || isLevelUpPaused) return;
    if (player.level < 2) {
        appendLog(L"[!] Starlight Nova unlocks at Level 2!");
        return;
    }
    if (player.novaCooldown > 0) return;

    player.novaCooldown = 120;
    spawnParticles(player.x, player.y, 36, COLOR_STAR_GOLD, 4.0f, 22, 4);

    float dx = enemy.x - player.x;
    float dy = enemy.y - player.y;
    if (std::sqrt(dx * dx + dy * dy) < 135.0f) {
        int dmg = static_cast<int>(player.attack * 1.6f) + (std::rand() % 10);
        enemy.hp -= dmg;
        enemy.hurtFlash = 10;
        spawnParticles(enemy.x, enemy.y, 25, RGB(255, 230, 100), 3.8f, 18, 4);
        appendLog(L"> Starlight Nova blasted foe for " + std::to_wstring(dmg) + L" holy dmg!");
        if (enemy.hp <= 0) onEnemyDefeated();
    }

    for (auto& m : minions) {
        if (!m.active) continue;
        float mdx = m.x - player.x;
        float mdy = m.y - player.y;
        if (std::sqrt(mdx * mdx + mdy * mdy) < 135.0f) {
            int dmg = player.attack + 12;
            m.hp -= dmg;
            m.hurtFlash = 10;
            if (m.hp <= 0) {
                m.active = false;
                player.gold += 8;
                player.exp += 10;
            }
        }
    }
}

void playerCastRay() {
    if (gameOver || !gameStarted || isLevelUpPaused) return;
    if (player.level < 3) {
        appendLog(L"[!] Eclipse Ray unlocks at Level 3!");
        return;
    }
    if (player.rayCooldown > 0) return;

    player.rayCooldown = 180;
    eclipseRay.active = true;
    eclipseRay.x1 = player.x;
    eclipseRay.y1 = player.y;
    eclipseRay.x2 = enemy.x;
    eclipseRay.y2 = enemy.y;
    eclipseRay.timer = 12;

    int dmg = (player.attack * 2) + (std::rand() % 15);
    enemy.hp -= dmg;
    enemy.hurtFlash = 12;
    spawnParticles(enemy.x, enemy.y, 30, RGB(220, 120, 255), 4.2f, 20, 4);

    appendLog(L"> Eclipse Ray pierced " + enemy.name + L" for " + std::to_wstring(dmg) + L" cosmic dmg!");
    if (enemy.hp <= 0) onEnemyDefeated();
}

void playerDrinkPotion() {
    if (gameOver || !gameStarted || isLevelUpPaused || player.potions <= 0) return;

    player.potions--;
    int healed = 35 + (player.level * 6);
    player.hp = (std::min)(player.maxHp, player.hp + healed);
    spawnParticles(player.x, player.y, 24, RGB(120, 255, 180), 2.2f, 18, 3);
    appendLog(L"> Quaffed Elixir! Restored " + std::to_wstring(healed) + L" HP.");
}

// 1. RPG HEROINE SPRITE (Sword, Shield, Cape, Armor)
void drawHeroine(HDC hdc, int cx, int cy, bool hurt) {
    int dir = player.facing;
    int bob = (int)(std::sin(player.walkCycle) * 2.0f);
    int legOffset = (int)(std::cos(player.walkCycle) * 3.0f);

    // Draped Cloak
    HBRUSH capeB = CreateSolidBrush(hurt ? RGB(255, 90, 90) : COLOR_CAPE);
    SelectObject(hdc, capeB);
    SelectObject(hdc, GetStockObject(NULL_PEN));
    POINT capePts[4] = {
        { cx - 10, cy - 6 + bob },
        { cx + 10, cy - 6 + bob },
        { cx + (8 * dir), cy + 18 },
        { cx - (12 * dir), cy + 18 }
    };
    Polygon(hdc, capePts, 4);
    DeleteObject(capeB);

    // Boots
    HBRUSH bootB = CreateSolidBrush(RGB(55, 45, 40));
    SelectObject(hdc, bootB);
    Ellipse(hdc, cx - 7 + legOffset, cy + 14, cx - 1 + legOffset, cy + 22);
    Ellipse(hdc, cx + 1 - legOffset, cy + 14, cx + 7 - legOffset, cy + 22);
    DeleteObject(bootB);

    // Tunic & Breastplate
    HBRUSH tunicB = CreateSolidBrush(COLOR_TUNIC);
    SelectObject(hdc, tunicB);
    Ellipse(hdc, cx - 9, cy - 6 + bob, cx + 9, cy + 14 + bob);
    DeleteObject(tunicB);

