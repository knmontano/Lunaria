void drawCanvasButton(HDC hdc, const RECT& rc, const std::wstring& text) {
    HBRUSH btnB = CreateSolidBrush(COLOR_BTN_NORMAL);
    FillRect(hdc, &rc, btnB);
    DeleteObject(btnB);

    HPEN pen = CreatePen(PS_SOLID, 1, COLOR_BTN_BORDER);
    HPEN oldPen = (HPEN)SelectObject(hdc, pen);
    SelectObject(hdc, GetStockObject(NULL_BRUSH));
    Rectangle(hdc, rc.left, rc.top, rc.right, rc.bottom);
    SelectObject(hdc, oldPen);
    DeleteObject(pen);

    SetBkMode(hdc, TRANSPARENT);
    SetTextColor(hdc, COLOR_TEXT_BODY);
    SelectObject(hdc, hMainFont);
    RECT tr = rc;
    DrawTextW(hdc, text.c_str(), -1, &tr, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
}

LRESULT CALLBACK WndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {
    case WM_CREATE: {
        hMainFont = CreateFontW(14, 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, VARIABLE_PITCH, L"Segoe UI");

        hHeaderFont = CreateFontW(15, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, VARIABLE_PITCH, L"Segoe UI");

        hEnemyTagFont = CreateFontW(11, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, VARIABLE_PITCH, L"Segoe UI");

        hTitleFont = CreateFontW(28, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, VARIABLE_PITCH, L"Segoe UI");

        hLogFont = CreateFontW(13, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, VARIABLE_PITCH, L"Consolas");

        SetTimer(hwnd, TIMER_GAME_LOOP, 16, NULL);
        break;
    }

    case WM_ERASEBKGND:
        return 1;

    case WM_TIMER: {
        if (wParam == TIMER_GAME_LOOP) {
            updateGamePhysics();
            InvalidateRect(hwnd, NULL, FALSE);
        }
        break;
    }

    case WM_LBUTTONDOWN: {
        int mx = LOWORD(lParam);
        int my = HIWORD(lParam);

        if (!gameStarted) {
            if (mx >= btnStartRect.left && mx <= btnStartRect.right && my >= btnStartRect.top && my <= btnStartRect.bottom) {
                startGame();
            } else if (mx >= btnExitRect.left && mx <= btnExitRect.right && my >= btnExitRect.top && my <= btnExitRect.bottom) {
                PostMessage(hwnd, WM_CLOSE, 0, 0);
            }
        } else if (gameOver) {
            if (mx >= btnRestartRect.left && mx <= btnRestartRect.right && my >= btnRestartRect.top && my <= btnRestartRect.bottom) {
                restartGame();
            }
        }
        break;
    }

    case WM_KEYDOWN: {
        if (wParam < 256) keys[wParam] = true;

        if (wParam == VK_ESCAPE) {
            PostMessage(hwnd, WM_CLOSE, 0, 0);
            return 0;
        }

        if (isLevelUpPaused) {
            if (wParam == '1') {
                if (player.gold >= 35) {
                    player.gold -= 35;
                    player.weaponTier++;
                    player.attack += 7;
                    appendLog(L"> Honed Weapon (+7 ATK)!");
                } else appendLog(L"[!] Need 35g for Weapon!");
            } else if (wParam == '2') {
                if (player.gold >= 30) {
                    player.gold -= 30;
                    player.armorTier++;
                    player.maxHp += 30;
                    player.hp = player.maxHp;
                    appendLog(L"> Enhanced Robes (+30 Max HP)!");
                } else appendLog(L"[!] Need 30g for Robes!");
            } else if (wParam == '3') {
                if (player.gold >= 20) {
                    player.gold -= 20;
                    player.potions++;
                    appendLog(L"> Brewed Star Elixir (+1)!");
                } else appendLog(L"[!] Need 20g for Elixir!");
            } else if (wParam == '4') {
                if (player.gold >= 50) {
                    player.gold -= 50;
                    companion.active = true;
                    companion.tier++;
                    companion.x = player.x - 30;
                    companion.y = player.y - 25;
                    appendLog(L"> Familiar empowered to Tier " + std::to_wstring(companion.tier) + L"!");
                } else appendLog(L"[!] Need 50g for Familiar!");
            } else if (wParam == VK_RETURN) {
                isLevelUpPaused = false;
                appendLog(L"> Resuming battle!");
                spawnEnemy();
            }
            return 0;
        }

        if (wParam == VK_RETURN) {
            if (!gameStarted) startGame();
            else if (gameOver) restartGame();
        } else if (wParam == VK_SPACE) {
            playerAttack();
        } else if (wParam == 'E') {
            playerDrinkPotion();
        } else if (wParam == 'Q') {
            playerCastNova();
        } else if (wParam == 'R') {
            playerCastRay();
        }
        break;
    }

    case WM_KEYUP: {
        if (wParam < 256) keys[wParam] = false;
        break;
    }

    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdcWindow = BeginPaint(hwnd, &ps);

        RECT clientRc;
        GetClientRect(hwnd, &clientRc);
        int winW = clientRc.right - clientRc.left;
        int winH = clientRc.bottom - clientRc.top;

        HDC hdcMem = CreateCompatibleDC(hdcWindow);
        HBITMAP hbmMem = CreateCompatibleBitmap(hdcWindow, winW, winH);
        HBITMAP hOldBmp = (HBITMAP)SelectObject(hdcMem, hbmMem);

        HBRUSH bgBrush = CreateSolidBrush(COLOR_WINDOW_BG);
        FillRect(hdcMem, &clientRc, bgBrush);
        DeleteObject(bgBrush);

        SetBkMode(hdcMem, TRANSPARENT);

        if (!gameStarted) {
            SelectObject(hdcMem, hTitleFont);
            SetTextColor(hdcMem, COLOR_TEXT_HEADER);
            RECT tr1 = { 50, 110, 535, 180 };
            DrawTextW(hdcMem, L"✧ LUNARIA ✧\nArena of the Star Maiden", -1, &tr1, DT_CENTER);

            SelectObject(hdcMem, hMainFont);
            SetTextColor(hdcMem, COLOR_TEXT_LOG);
            RECT tr2 = { 50, 215, 535, 250 };
            DrawTextW(hdcMem, L"Press [ ENTER ] to Play   |   Press [ ESC ] to Exit", -1, &tr2, DT_CENTER);

            drawCanvasButton(hdcMem, btnStartRect, L"✦ ENTER THE ARENA ✦");
            drawCanvasButton(hdcMem, btnExitRect, L"✕ Exit Game");
        } else {
            RECT arenaRc = { ARENA_X, ARENA_Y, ARENA_X + ARENA_W, ARENA_Y + ARENA_H };
            HBRUSH arenaFloorB = CreateSolidBrush(COLOR_ARENA_FLOOR);
            FillRect(hdcMem, &arenaRc, arenaFloorB);
            DeleteObject(arenaFloorB);

            HPEN gridPen = CreatePen(PS_SOLID, 1, COLOR_ARENA_GRID);
            HPEN oldPen = (HPEN)SelectObject(hdcMem, gridPen);
            for (int gx = ARENA_X + 40; gx < ARENA_X + ARENA_W; gx += 40) {
                MoveToEx(hdcMem, gx, PLAY_TOP, NULL);
                LineTo(hdcMem, gx, ARENA_Y + ARENA_H);
            }
            for (int gy = PLAY_TOP + 20; gy < ARENA_Y + ARENA_H; gy += 40) {
                MoveToEx(hdcMem, ARENA_X, gy, NULL);
                LineTo(hdcMem, ARENA_X + ARENA_W, gy);
            }
            SelectObject(hdcMem, oldPen);
            DeleteObject(gridPen);

            HPEN borderPen = CreatePen(PS_SOLID, 2, COLOR_BTN_BORDER);
            oldPen = (HPEN)SelectObject(hdcMem, borderPen);
            SelectObject(hdcMem, GetStockObject(NULL_BRUSH));
            Rectangle(hdcMem, ARENA_X, ARENA_Y, ARENA_X + ARENA_W, ARENA_Y + ARENA_H);
            SelectObject(hdcMem, oldPen);
            DeleteObject(borderPen);

            if (!isLevelUpPaused) {
                if (eclipseRay.active) {
                    HPEN rayPen = CreatePen(PS_SOLID, 5, RGB(220, 140, 255));
                    oldPen = (HPEN)SelectObject(hdcMem, rayPen);
                    MoveToEx(hdcMem, static_cast<int>(eclipseRay.x1), static_cast<int>(eclipseRay.y1), NULL);
                    LineTo(hdcMem, static_cast<int>(eclipseRay.x2), static_cast<int>(eclipseRay.y2));
                    SelectObject(hdcMem, oldPen);
                    DeleteObject(rayPen);
                }

                if (companion.active) {
                    drawCompanion(hdcMem, static_cast<int>(companion.x), static_cast<int>(companion.y));
                }

                drawHeroine(hdcMem, static_cast<int>(player.x), static_cast<int>(player.y), player.hurtFlash > 0);
                if (!gameOver) {
                    drawRival(hdcMem, static_cast<int>(enemy.x), static_cast<int>(enemy.y), enemy.hurtFlash > 0);
                }

                for (const auto& m : minions) {
                    if (m.active) drawMinion(hdcMem, static_cast<int>(m.x), static_cast<int>(m.y), m.hurtFlash > 0);
                }

                for (const auto& pr : projectiles) {
                    HBRUSH prB = CreateSolidBrush(COLOR_FAIRY_GLOW);
                    SelectObject(hdcMem, prB);
                    SelectObject(hdcMem, GetStockObject(NULL_PEN));
                    Ellipse(hdcMem, static_cast<int>(pr.x - 3), static_cast<int>(pr.y - 3), 
                                    static_cast<int>(pr.x + 3), static_cast<int>(pr.y + 3));
                    DeleteObject(prB);
                }

                for (const auto& p : particles) {
                    HBRUSH pBrush = CreateSolidBrush(p.color);
                    SelectObject(hdcMem, pBrush);
                    SelectObject(hdcMem, GetStockObject(NULL_PEN));
                    Ellipse(hdcMem, static_cast<int>(p.x - p.size), static_cast<int>(p.y - p.size), 
                                    static_cast<int>(p.x + p.size), static_cast<int>(p.y + p.size));
                    DeleteObject(pBrush);
                }

                RECT hudBgRc = { ARENA_X + 2, ARENA_Y + 2, ARENA_X + ARENA_W - 2, PLAY_TOP };
                HBRUSH hudBgB = CreateSolidBrush(RGB(20, 14, 34));
                FillRect(hdcMem, &hudBgRc, hudBgB);
                DeleteObject(hudBgB);

                HPEN divPen = CreatePen(PS_SOLID, 1, RGB(55, 38, 80));
                oldPen = (HPEN)SelectObject(hdcMem, divPen);
                MoveToEx(hdcMem, ARENA_X + 2, PLAY_TOP, NULL);
                LineTo(hdcMem, ARENA_X + ARENA_W - 2, PLAY_TOP);
                SelectObject(hdcMem, oldPen);
                DeleteObject(divPen);

                SelectObject(hdcMem, hHeaderFont);
                SetTextColor(hdcMem, COLOR_TEXT_HEADER);
                std::wstring heroHud = L"✦ Lunaria Lv." + std::to_wstring(player.level) + 
                                      L"   HP: " + std::to_wstring(player.hp) + L"/" + std::to_wstring(player.maxHp) + 
                                      L"   EXP: " + std::to_wstring(player.exp) + L"/" + std::to_wstring(player.expNeeded);
                if (companion.active) heroHud += L"  [✦ Sylph]";
                TextOutW(hdcMem, ARENA_X + 10, ARENA_Y + 7, heroHud.c_str(), heroHud.length());

                SetTextColor(hdcMem, COLOR_COIN_GOLD);
                std::wstring coinHud = L"[ 🪙 Coins: " + std::to_wstring(player.gold) + L"g ]";
                TextOutW(hdcMem, ARENA_X + ARENA_W - 145, ARENA_Y + 7, coinHud.c_str(), coinHud.length());
            } else {
                HBRUSH modalBg = CreateSolidBrush(RGB(38, 26, 58));
                RECT modalRc = { ARENA_X + 30, ARENA_Y + 25, ARENA_X + ARENA_W - 30, ARENA_Y + ARENA_H - 18 };
                FillRect(hdcMem, &modalRc, modalBg);
                DeleteObject(modalBg);

                HPEN modalBorder = CreatePen(PS_SOLID, 2, COLOR_STAR_GOLD);
                oldPen = (HPEN)SelectObject(hdcMem, modalBorder);
                SelectObject(hdcMem, GetStockObject(NULL_BRUSH));
                Rectangle(hdcMem, modalRc.left, modalRc.top, modalRc.right, modalRc.bottom);
                SelectObject(hdcMem, oldPen);
                DeleteObject(modalBorder);

                SelectObject(hdcMem, hHeaderFont);
                SetTextColor(hdcMem, COLOR_STAR_GOLD);
                RECT trHeader = { modalRc.left, modalRc.top + 16, modalRc.right, modalRc.top + 40 };
                DrawTextW(hdcMem, L"✦ STAR MAIDEN'S SANCTUARY ✦", -1, &trHeader, DT_CENTER);

                SetTextColor(hdcMem, COLOR_COIN_GOLD);
                std::wstring bankStr = L"Your Coin Balance: " + std::to_wstring(player.gold) + L" Gold";
                RECT trBank = { modalRc.left, modalRc.top + 38, modalRc.right, modalRc.top + 58 };
                DrawTextW(hdcMem, bankStr.c_str(), -1, &trBank, DT_CENTER);

                SelectObject(hdcMem, hMainFont);
                SetTextColor(hdcMem, COLOR_TEXT_BODY);
                TextOutW(hdcMem, modalRc.left + 40, modalRc.top + 65, L"[1] Upgrade Sword (+7 ATK) - 35g", 32);
                TextOutW(hdcMem, modalRc.left + 40, modalRc.top + 95, L"[2] Enhance Armor (+30 Max HP) - 30g", 36);
                TextOutW(hdcMem, modalRc.left + 40, modalRc.top + 125, L"[3] Brew Health Potion (+1) - 20g", 33);
                TextOutW(hdcMem, modalRc.left + 40, modalRc.top + 155, L"[4] Summon / Empower Familiar - 50g", 35);

                SelectObject(hdcMem, hHeaderFont);
                SetTextColor(hdcMem, COLOR_TEXT_HEADER);
                RECT trResume = { modalRc.left, modalRc.top + 192, modalRc.right, modalRc.top + 218 };
                DrawTextW(hdcMem, L"Press [ENTER] to Resume Battle", -1, &trResume, DT_CENTER);
            }

            SelectObject(hdcMem, hMainFont);
            SetTextColor(hdcMem, COLOR_TEXT_LOG);

            float slashSec = player.attackCooldown / 60.0f;
            float novaSec = player.novaCooldown / 60.0f;
            float raySec = player.rayCooldown / 60.0f;

            wchar_t cdBuf[256];
            swprintf_s(cdBuf, 256, 
                L"[SPACE] Slash: %ls | [Q] Nova: %ls | [R] Ray: %ls | [E] Potion (%d)",
                (player.attackCooldown == 0 ? L"READY" : (std::to_wstring(slashSec).substr(0, 3) + L"s").c_str()),
                (player.level < 2 ? L"Lv.2" : (player.novaCooldown == 0 ? L"READY" : (std::to_wstring(novaSec).substr(0, 3) + L"s").c_str())),
                (player.level < 3 ? L"Lv.3" : (player.rayCooldown == 0 ? L"READY" : (std::to_wstring(raySec).substr(0, 3) + L"s").c_str())),
                player.potions);

            TextOutW(hdcMem, ARENA_X + 10, ARENA_Y + ARENA_H + 8, cdBuf, wcslen(cdBuf));

            RECT logBoxRc = { ARENA_X, ARENA_Y + ARENA_H + 32, ARENA_X + ARENA_W, ARENA_Y + ARENA_H + 165 };
            HBRUSH logBoxB = CreateSolidBrush(RGB(14, 10, 22));
            FillRect(hdcMem, &logBoxRc, logBoxB);
            DeleteObject(logBoxB);

            HPEN logBorderP = CreatePen(PS_SOLID, 1, RGB(55, 40, 80));
            oldPen = (HPEN)SelectObject(hdcMem, logBorderP);
            SelectObject(hdcMem, GetStockObject(NULL_BRUSH));
            Rectangle(hdcMem, logBoxRc.left, logBoxRc.top, logBoxRc.right, logBoxRc.bottom);
            SelectObject(hdcMem, oldPen);
            DeleteObject(logBorderP);

            SelectObject(hdcMem, hLogFont);
            SetTextColor(hdcMem, COLOR_TEXT_LOG);
            int curY = logBoxRc.top + 6;
            for (const auto& line : logLines) {
                TextOutW(hdcMem, logBoxRc.left + 10, curY, line.c_str(), line.length());
                curY += 16;
            }

            if (gameOver) {
                drawCanvasButton(hdcMem, btnRestartRect, L"⟳ Reclaim Arena");
            }
        }

        BitBlt(hdcWindow, 0, 0, winW, winH, hdcMem, 0, 0, SRCCOPY);

        SelectObject(hdcMem, hOldBmp);
        DeleteObject(hbmMem);
        DeleteDC(hdcMem);
        EndPaint(hwnd, &ps);
        return 0;
    }

    case WM_DESTROY:
        KillTimer(hwnd, TIMER_GAME_LOOP);
        DeleteObject(hMainFont);
        DeleteObject(hHeaderFont);
        DeleteObject(hEnemyTagFont);
        DeleteObject(hTitleFont);
        DeleteObject(hLogFont);
        PostQuitMessage(0);
        break;

    default:
        return DefWindowProcW(hwnd, msg, wParam, lParam);
    }
    return 0;
}

int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE, LPSTR, int nCmdShow) {
    std::srand((unsigned)std::time(nullptr));

    const wchar_t CLASS_NAME[] = L"LunariaArenaClass";

    WNDCLASSW wc = {};
    wc.lpfnWndProc = WndProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = CLASS_NAME;
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground = NULL;

    RegisterClassW(&wc);

    hwndMain = CreateWindowExW(
        0, CLASS_NAME, L"Lunaria: Arena of the Star Maiden",
        WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX,
        CW_USEDEFAULT, CW_USEDEFAULT, 600, 510,
        NULL, NULL, hInstance, NULL
    );

    if (!hwndMain) return 0;

    ShowWindow(hwndMain, nCmdShow);
    UpdateWindow(hwndMain);

    MSG msg = {};
    while (GetMessageW(&msg, NULL, 0, 0)) {
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }

    return 0;
}